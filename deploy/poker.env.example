# Copy to /srv/poker/poker.env and chmod 600.
# The systemd unit reads this file through EnvironmentFile=.

NODE_ENV=production
PORT=3100
HOST=127.0.0.1

DATA_DIR=/srv/poker/data
PUBLIC_DIR=/srv/poker/dist/public

# Full public entry point including the sub-path, no trailing slash.
PUBLIC_URL=https://poker.example.com/poker
# Must match the value used for "POKER_BASE=... npm run build".
POKER_BASE=/poker/

COOKIE_SECURE=true
TRUST_PROXY=true

# Generate with: openssl rand -base64 48
SESSION_SECRET=replace-with-32-bytes-of-random

# Bootstrap only; ignored once data/admin.json exists.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password

# Generate with: openssl rand -base64 48
TABLE_ADMIN_KEY=replace-with-another-long-random-string
