{
  "name": "poker-room",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Single-room multiplayer Texas Hold'em for friends",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "node scripts/build-server.mjs",
    "start": "node dist/server.js",
    "test": "node --import tsx --test tests/game.test.ts tests/room.test.ts tests/store.test.ts tests/config.test.ts tests/server.test.ts && node scripts/smoke-server.mjs",
    "smoke:server": "node scripts/smoke-server.mjs",
    "typecheck": "tsc --noEmit",
    "admin:create": "tsx scripts/create-admin.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^10.1.9",
    "@fastify/websocket": "^11.0.1",
    "fastify": "^5.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.2",
    "typescript": "^5.8.2",
    "vite": "^6.0.7"
  }
}
