# --- HTTP server ---
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Where room.json, admin.json and admin-audit.jsonl are stored.
DATA_DIR=./data

# Built client (npm run build writes here).
PUBLIC_DIR=./dist/public

# Full public entry point, including any sub-path, without a trailing slash.
# Required when NODE_ENV=production and whenever POKER_BASE is not "/".
# Invite links are built from this value instead of from request headers.
PUBLIC_URL=https://poker.example.com

# Client build base. Build the client with the same value:
#   POKER_BASE=/poker/ npm run build
# At runtime, set it too so the server can verify PUBLIC_URL.
# Root deployment: leave as "/". Sub-path deployment: "/poker/".
POKER_BASE=/

# Sub-path example (Caddy strips /poker before proxying):
# PUBLIC_URL=https://tangping.work:8443/poker
# POKER_BASE=/poker/

# Set to true behind HTTPS (Caddy) so cookies get the Secure flag.
COOKIE_SECURE=true

# Trust X-Forwarded-* headers from the reverse proxy so request.ip is the client.
TRUST_PROXY=true

# --- Secrets ---
# Signs admin session cookies. Use a long random string (32+ bytes).
SESSION_SECRET=replace-with-32-bytes-of-random

# Permanent administrator account used by /admin. Password must be at least 12 characters.
# Only used to bootstrap data/admin.json when it does not exist yet.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password

# In-table emergency administrator key. Unlocks admin actions on the current WebSocket only.
TABLE_ADMIN_KEY=replace-with-another-long-random-string
